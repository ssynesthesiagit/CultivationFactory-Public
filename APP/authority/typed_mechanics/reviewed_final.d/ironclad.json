    "BLACKSMITH_BASE_QUENCH_THE_MARK": {
      "text_sha256": "86533227937bdeff51a0131623d7800de0e672db0a8aa2919e303d0a305b811c",
      "reviewed_by": "w4-roster 2026-09-28",
      "riders": [
        "Spend Forge Marks to activate a Blacksmith response, talent, or improvement.",
        "A quench may be literal water, oil, snow, blood, spirit breath, cold iron, furnace wind, silence, or the moment when the hammer stops."
      ]
    },
    "BLACKSMITH_BASE_READ_THE_FLAW": {
      "text_sha256": "3f6557ef3e83e9ecf423b1cb6b302124c844d8c7811a8395d05659f7c5bcfd61",
      "reviewed_by": "w4-roster 2026-09-28",
      "effects": [],
      "riders": [
        "Make an Intelligence check using Smith’s Tools against a DC set by the GM.",
        "If the workpiece is part of a creature’s equipment, the DC is normally the creature’s Armor Class or your Blacksmith Save DC, whichever is higher.",
        "On a success, learn two of the following: whether the object is damaged; whether the object is nonmagical, magical, or artifact-level; whether the object is poorly made, ordinary, fine, masterwork, spiritual, or anomalous; one material used in the object; whether the object has a hidden flaw; whether the object has been repaired before; whether the object is under an active magical or sphere effect; whether the object is suitable for a Blacksmith talent you know; what kind of tool, furnace, or material would help improve it; whether the object is resisting your work.",
        "If you spend 1 minute instead of an Action, also place 1 Forge Mark on the workpiece on a successful check.",
        "You may use Read the Flaw without a check on a nonmagical object you own, made, or have worked on for at least 10 minutes."
      ]
    },

