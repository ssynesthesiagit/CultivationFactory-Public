   "duration": {"kind": "instant", "amount": null, "concentration": false},
   "effects": [{"type": "iron_open_hand", "evidence": "On an Unarmed Strike hit, forgo Open the Gate to contest one chosen held object: attack roll vs target's choice of Athletics or Acrobatics; success drops it, failure has no additional effect. Two-handed Disadvantage and target size modes apply."}],
   "riders": [
    "Open-Hand Disarm runs on ordinary compiled Unarmed Strike hits against represented held weapons. General held objects, legacy untyped weapon provenance, and actual two-hand grip for versatile weapons require held-object/hand-state support; size modes compare represented footprints (distinct sizes sharing one footprint require creature-size authority); reaction-only strike callers remain pending integration.",
    "If you possess the Scoundrel sphere, you may immediately use Steal against the dropped object if it is within your reach. Immediate Steal's free-hand/result choice remains pending; ordinary weapon pickup still runs."
   ],
   "description": ["Failure: No additional effect."],
   "coverage": "CORE_WITH_RIDERS",
