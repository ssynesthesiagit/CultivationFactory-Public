{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Stage2_Field_Provenance_Map.schema.json",
  "title": "Stage 2 Field Provenance Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_revision",
    "entries",
    "event_count",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "TianxiaFoundry.Stage2FieldProvenanceMap.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_ids",
          "event_hashes",
          "catalog_record_ids",
          "catalog_record_hashes",
          "acquisition_channels",
          "source_evidence",
          "calculation"
        ],
        "properties": {
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "event_hashes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "catalog_record_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "catalog_record_hashes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "acquisition_channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "source_hash",
                "source_anchor",
                "source_path"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_anchor": {
                  "type": "string",
                  "minLength": 1
                },
                "source_path": {
                  "type": "string"
                }
              }
            }
          },
          "calculation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "inputs",
              "outputs"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object"
              },
              "outputs": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "proven",
        "unproven"
      ],
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 1
        },
        "proven": {
          "type": "integer",
          "minimum": 0
        },
        "unproven": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
