{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Advancement_Event_v2.schema.json",
  "title": "Tianxia Advancement Event v2 — Stage 2 Mechanical Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "project_id",
    "project_revision",
    "sequence",
    "event_type",
    "effective_point",
    "legal_channel",
    "subject",
    "content_binding",
    "source_evidence",
    "created_records",
    "updated_records",
    "retired_records",
    "idempotency_key",
    "previous_event_hash",
    "state_before_hash",
    "state_after_hash",
    "event_hash",
    "created_at",
    "advancement"
  ],
  "properties": {
    "schema_version": {
      "const": "TianxiaFoundry.AdvancementEvent.v2"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "acquire",
        "evolve",
        "replace",
        "retire",
        "author_metadata",
        "lock_change",
        "migration"
      ]
    },
    "effective_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "character_cl",
        "order"
      ],
      "properties": {
        "kind": {
          "enum": [
            "level",
            "background_creation",
            "manual_training",
            "foundation_awakening",
            "foundation_refinement",
            "foundation_perfection",
            "loot_acquisition",
            "downtime_forging",
            "companion_bond",
            "migration",
            "other"
          ]
        },
        "character_cl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "legal_channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "content_type"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "content_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "pack_version",
        "pack_hash",
        "record_hash",
        "catalog_build_id"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "pack_version": {
          "type": "string"
        },
        "pack_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "catalog_build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_hash",
          "source_anchor"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_anchor": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string"
          },
          "line_ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot_cost": {
          "type": "integer",
          "minimum": 0
        },
        "capacity_type": {
          "type": "string"
        },
        "capacity_before": {
          "type": "number"
        },
        "capacity_after": {
          "type": "number"
        }
      }
    },
    "training": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "dc": {
          "type": "integer"
        },
        "time_days": {
          "type": "number",
          "minimum": 0
        },
        "roll_total": {
          "type": "integer"
        },
        "result": {
          "enum": [
            "success",
            "failure",
            "automatic",
            "not_applicable"
          ]
        }
      }
    },
    "created_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "updated_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "retired_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "planner_response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "migration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_before_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_after_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "advancement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_cl",
        "calculation",
        "prerequisite_record_ids",
        "prerequisite_event_ids",
        "details"
      ],
      "properties": {
        "kind": {
          "enum": [
            "starting_state",
            "level_advance",
            "ability_score_change",
            "background_acquisition",
            "background_sphere_acquisition",
            "background_talent_acquisition",
            "origin_insight_acquisition",
            "path_acquisition",
            "subpath_acquisition",
            "method_acquisition",
            "method_activation",
            "foundation_acquisition",
            "foundation_expression",
            "foundation_stage",
            "sphere_acquisition",
            "talent_acquisition",
            "manual_acquisition",
            "forged_technique_acquisition",
            "equipment_acquisition",
            "typed_none"
          ]
        },
        "target_cl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule_id",
            "inputs",
            "outputs"
          ],
          "properties": {
            "rule_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "inputs": {
              "type": "object"
            },
            "outputs": {
              "type": "object"
            }
          }
        },
        "prerequisite_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "prerequisite_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "details": {
          "type": "object"
        },
        "none_state": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "state",
            "reason_code",
            "reason",
            "source_backed"
          ],
          "properties": {
            "state": {
              "const": "none"
            },
            "reason_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "source_backed": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
