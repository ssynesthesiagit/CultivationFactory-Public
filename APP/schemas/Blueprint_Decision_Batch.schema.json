{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Blueprint_Decision_Batch.schema.json",
  "title": "Tianxia Foundry Blueprint Decision Batch",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "batch_id", "attempt_id", "project_id", "prompt_id", "expected_project_revision", "catalog_build_id", "content_lock_hash", "exact_response_sha256", "computed_payload_sha256", "state", "decisions", "authored_notes", "planner_rationale", "batch_hash"],
  "properties": {
    "schema_version": {"const": "TianxiaFoundry.BlueprintDecisionBatch.v1"},
    "batch_id": {"type": "string"}, "attempt_id": {"type": "string"}, "project_id": {"type": "string"}, "prompt_id": {"type": "string"},
    "response_id": {"type": ["string", "null"]}, "expected_project_revision": {"type": "integer", "minimum": 0}, "catalog_build_id": {"type": "string"},
    "content_lock_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "exact_response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "computed_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "submitted_payload_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["validated", "approval_pending", "approved", "committed", "projection_pending", "projected", "projection_failed"]},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "authored_notes": {"type": "array", "items": {"type": "object"}},
    "planner_rationale": {"type": "string"}, "batch_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
