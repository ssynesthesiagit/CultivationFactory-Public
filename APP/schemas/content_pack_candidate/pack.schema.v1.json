{
  "$defs": {
    "blocker": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "capability": {
          "enum": [
            "advancement",
            "character_sheet",
            "gm_display",
            "combat_execution",
            "ai_policy"
          ]
        },
        "pack_id": {
          "$ref": "#/$defs/stable_id"
        },
        "primitive_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_id": {
          "$ref": "#/$defs/stable_id"
        }
      },
      "type": "object"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "advancement": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "ai_policy": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "character_sheet": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "combat_execution": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "gm_display": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        }
      },
      "required": [
        "advancement",
        "character_sheet",
        "gm_display",
        "combat_execution",
        "ai_policy"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_binding": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "source_path": {
          "minLength": 1,
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "source_sha256",
        "anchor"
      ],
      "type": "object"
    },
    "stable_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "type": "string"
    }
  },
  "$id": "urn:tianxia:candidate:content-pack:manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_classification": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_status": {
      "const": "CANDIDATE_NON_AUTHORITATIVE"
    },
    "capability_declarations": {
      "$ref": "#/$defs/capabilities"
    },
    "checksum_identity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "manifest": {
          "const": "SHA256SUMS.txt"
        }
      },
      "required": [
        "algorithm",
        "manifest"
      ],
      "type": "object"
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "compiler": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "factory": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "dependencies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "optional": {
            "default": false,
            "type": "boolean"
          },
          "pack_id": {
            "$ref": "#/$defs/stable_id"
          },
          "required_capabilities": {
            "items": {
              "enum": [
                "advancement",
                "character_sheet",
                "gm_display",
                "combat_execution",
                "ai_policy"
              ]
            },
            "type": "array",
            "uniqueItems": true
          },
          "version_range": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "version_range"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "lifecycle": {
      "additionalProperties": false,
      "properties": {
        "migration_policy": {
          "enum": [
            "NONE",
            "DECLARATIVE_ONLY",
            "REQUIRES_REVIEW"
          ]
        },
        "replaces": {
          "items": {
            "$ref": "#/$defs/stable_id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "supersedes": {
          "items": {
            "$ref": "#/$defs/stable_id"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "optional_files": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "pack_id": {
      "$ref": "#/$defs/stable_id"
    },
    "record_inventory": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "record_type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "record_type",
          "count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "TianxiaContentPackCandidate.Manifest.v1"
    },
    "schema_versions": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "source_identity": {
      "$ref": "#/$defs/source_binding"
    },
    "version": {
      "$ref": "#/$defs/semver"
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "pack_id",
    "version",
    "authority_classification",
    "source_identity",
    "schema_versions",
    "dependencies",
    "compatibility",
    "record_inventory",
    "capability_declarations",
    "checksum_identity",
    "lifecycle"
  ],
  "title": "Tianxia Candidate Content Pack Manifest v1",
  "type": "object"
}
