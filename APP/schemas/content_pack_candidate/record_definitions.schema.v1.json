{
  "$defs": {
    "blocker": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "capability": {
          "enum": [
            "advancement",
            "character_sheet",
            "gm_display",
            "combat_execution",
            "ai_policy"
          ]
        },
        "pack_id": {
          "$ref": "#/$defs/stable_id"
        },
        "primitive_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_id": {
          "$ref": "#/$defs/stable_id"
        }
      },
      "type": "object"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "advancement": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "ai_policy": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "character_sheet": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "combat_execution": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "gm_display": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        }
      },
      "required": [
        "advancement",
        "character_sheet",
        "gm_display",
        "combat_execution",
        "ai_policy"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_binding": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "source_path": {
          "minLength": 1,
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "source_sha256",
        "anchor"
      ],
      "type": "object"
    },
    "stable_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "type": "string"
    }
  },
  "$id": "urn:tianxia:candidate:content-pack:definitions:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_status": {
      "const": "CANDIDATE_NON_AUTHORITATIVE"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "advancement_authority": {
            "minProperties": 1,
            "type": "object"
          },
          "capabilities": {
            "$ref": "#/$defs/capabilities"
          },
          "capability_blockers": {
            "items": {
              "$ref": "#/$defs/blocker"
            },
            "type": "array"
          },
          "controller_policy_id": {
            "$ref": "#/$defs/stable_id"
          },
          "display_name": {
            "minLength": 1,
            "type": "string"
          },
          "display_representation": {
            "additionalProperties": false,
            "properties": {
              "authenticated": {
                "type": "boolean"
              },
              "summary": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "authenticated",
              "summary"
            ],
            "type": "object"
          },
          "execution_definition_ids": {
            "items": {
              "$ref": "#/$defs/stable_id"
            },
            "type": "array",
            "uniqueItems": true
          },
          "gm_projection": {
            "minProperties": 1,
            "type": "object"
          },
          "record_dependencies": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "capability": {
                  "enum": [
                    "advancement",
                    "character_sheet",
                    "gm_display",
                    "combat_execution",
                    "ai_policy"
                  ]
                },
                "record_id": {
                  "$ref": "#/$defs/stable_id"
                }
              },
              "required": [
                "record_id",
                "capability"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "record_id": {
            "$ref": "#/$defs/stable_id"
          },
          "record_type": {
            "enum": [
              "rule",
              "sphere",
              "talent",
              "path",
              "subpath",
              "foundation",
              "item",
              "recorded_art",
              "forged_technique",
              "companion",
              "creature",
              "controller_policy"
            ]
          },
          "record_version": {
            "$ref": "#/$defs/semver"
          },
          "selectable": {
            "type": "boolean"
          },
          "source_binding": {
            "$ref": "#/$defs/source_binding"
          },
          "tactical_metadata": {
            "minProperties": 1,
            "type": "object"
          }
        },
        "required": [
          "record_id",
          "record_version",
          "record_type",
          "display_name",
          "selectable",
          "source_binding",
          "capabilities"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "TianxiaContentPackCandidate.Definitions.v1"
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "records"
  ],
  "title": "Tianxia Candidate Record Definitions v1",
  "type": "object"
}
