{
  "$defs": {
    "blocker": {
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "capability": {
          "enum": [
            "advancement",
            "character_sheet",
            "gm_display",
            "combat_execution",
            "ai_policy"
          ]
        },
        "pack_id": {
          "$ref": "#/$defs/stable_id"
        },
        "primitive_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_id": {
          "$ref": "#/$defs/stable_id"
        }
      },
      "type": "object"
    },
    "capabilities": {
      "additionalProperties": false,
      "properties": {
        "advancement": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "ai_policy": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "character_sheet": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "combat_execution": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        },
        "gm_display": {
          "enum": [
            "SUPPORTED",
            "PARTIAL",
            "UNSUPPORTED",
            "NOT_APPLICABLE",
            "STALE",
            "BLOCKED_BY_DEPENDENCY"
          ]
        }
      },
      "required": [
        "advancement",
        "character_sheet",
        "gm_display",
        "combat_execution",
        "ai_policy"
      ],
      "type": "object"
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_binding": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "source_path": {
          "minLength": 1,
          "type": "string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "source_sha256",
        "anchor"
      ],
      "type": "object"
    },
    "stable_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "type": "string"
    }
  },
  "$id": "urn:tianxia:candidate:tianxiacontentpackcandidate.controllerpolicies.v1:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_status": {
      "const": "CANDIDATE_NON_AUTHORITATIVE"
    },
    "policies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "policy_id": {
            "$ref": "#/$defs/stable_id"
          },
          "primitive_ids": {
            "items": {
              "$ref": "#/$defs/stable_id"
            },
            "type": "array",
            "uniqueItems": true
          },
          "requires_combat_execution": {
            "type": "boolean"
          },
          "source_binding": {
            "$ref": "#/$defs/source_binding"
          },
          "tactical_metadata": {
            "minProperties": 1,
            "type": "object"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "policy_id",
          "version",
          "source_binding",
          "requires_combat_execution",
          "tactical_metadata",
          "primitive_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "TianxiaContentPackCandidate.ControllerPolicies.v1"
    }
  },
  "required": [
    "schema_version",
    "candidate_status",
    "policies"
  ],
  "type": "object"
}
