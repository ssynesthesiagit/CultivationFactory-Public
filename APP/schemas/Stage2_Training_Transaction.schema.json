{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Stage2_Training_Transaction.schema.json",
  "title": "Stage 2 Training Transaction v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "retry_of_attempt_id",
    "character_cl",
    "training_type",
    "target_record_id",
    "target_record_hash",
    "training_source_record_id",
    "training_source_record_hash",
    "training_source_access_event_id",
    "selected_ability",
    "study_time_mode",
    "study_time_value",
    "time_die_result",
    "pb_input",
    "ability_modifier_input",
    "training_days_formula_id",
    "computed_training_days",
    "recorded_art_difficulty",
    "recorded_arts_learned_this_cl_before",
    "learning_dc_mode",
    "dc_die_result",
    "dc_formula_id",
    "dc_inputs",
    "computed_dc",
    "check_die_result",
    "check_formula_id",
    "check_ability",
    "check_ability_modifier_input",
    "check_pb_input",
    "computed_check_total",
    "result",
    "slot_cost",
    "acquisition_event_id"
  ],
  "properties": {
    "schema_version": {
      "const": "TianxiaFoundry.Stage2TrainingTransaction.v2"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "retry_of_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "character_cl": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "training_type": {
      "enum": [
        "new_sphere",
        "known_sphere_talent",
        "recorded_art",
        "published_other"
      ]
    },
    "target_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "target_record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "training_source_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "training_source_record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "training_source_access_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "selected_ability": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "study_time_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "study_time_value": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "time_die_result": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 6
    },
    "pb_input": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "ability_modifier_input": {
      "type": "integer",
      "minimum": -5,
      "maximum": 10
    },
    "training_days_formula_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "computed_training_days": {
      "type": "integer",
      "minimum": 0
    },
    "recorded_art_difficulty": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "recorded_arts_learned_this_cl_before": {
      "type": "integer",
      "minimum": 0
    },
    "learning_dc_mode": {
      "enum": [
        "ordinary_training",
        "difficulty_formula",
        "explicit_dc_override"
      ]
    },
    "dc_die_result": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4
    },
    "dc_formula_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "dc_inputs": {
      "type": "object"
    },
    "computed_dc": {
      "type": "integer",
      "minimum": 0
    },
    "check_die_result": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "check_formula_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "check_ability": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "check_ability_modifier_input": {
      "type": "integer",
      "minimum": -5,
      "maximum": 10
    },
    "check_pb_input": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "computed_check_total": {
      "type": "integer",
      "minimum": -20,
      "maximum": 100
    },
    "result": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "slot_cost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "acquisition_event_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
