{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Advancement_Event.schema.json",
  "title": "Tianxia Advancement Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "project_id",
    "project_revision",
    "sequence",
    "event_type",
    "effective_point",
    "legal_channel",
    "subject",
    "content_binding",
    "source_evidence",
    "created_records",
    "updated_records",
    "retired_records",
    "idempotency_key",
    "previous_event_hash",
    "state_before_hash",
    "state_after_hash",
    "event_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "TianxiaFoundry.AdvancementEvent.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "enum": [
        "acquire",
        "evolve",
        "replace",
        "retire",
        "author_metadata",
        "lock_change",
        "migration"
      ]
    },
    "effective_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "character_cl",
        "order"
      ],
      "properties": {
        "kind": {
          "enum": [
            "level",
            "background_creation",
            "manual_training",
            "foundation_awakening",
            "foundation_refinement",
            "foundation_perfection",
            "loot_acquisition",
            "downtime_forging",
            "companion_bond",
            "migration",
            "other"
          ]
        },
        "character_cl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "legal_channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "content_type"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "content_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "pack_version",
        "pack_hash",
        "record_hash",
        "catalog_build_id"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "pack_version": {
          "type": "string"
        },
        "pack_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "catalog_build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_hash",
          "source_anchor"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_anchor": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string"
          },
          "line_ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot_cost": {
          "type": "integer",
          "minimum": 0
        },
        "capacity_type": {
          "type": "string"
        },
        "capacity_before": {
          "type": "number"
        },
        "capacity_after": {
          "type": "number"
        }
      }
    },
    "training": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "dc": {
          "type": "integer"
        },
        "time_days": {
          "type": "number",
          "minimum": 0
        },
        "roll_total": {
          "type": "integer"
        },
        "result": {
          "enum": [
            "success",
            "failure",
            "automatic",
            "not_applicable"
          ]
        }
      }
    },
    "created_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "updated_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "retired_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "planner_response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "migration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_before_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_after_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
