{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/AI_Stage_Response.schema.json",
  "title": "Tianxia Foundry AI Stage Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "response_id",
    "packet_id",
    "project_id",
    "project_revision",
    "stage",
    "content_lock_hash",
    "status",
    "decisions",
    "authored_fields",
    "composites",
    "uncertainties"
  ],
  "properties": {
    "protocol_version": {
      "const": "TianxiaFoundry.AIClipboard.v1"
    },
    "response_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "content_lock_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "abstain"
      ]
    },
    "decisions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "request_id",
          "choice_ids",
          "rationale"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "choice_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "ranked_choice_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "authored_fields": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "value"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "value": {
            "type": "string",
            "maxLength": 12000
          },
          "source_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        }
      }
    },
    "composites": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "composite_request_id",
          "name",
          "sequence",
          "when_to_use",
          "fallback"
        ],
        "properties": {
          "composite_request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sequence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "step",
                "reference_type",
                "reference_id",
                "round_offset"
              ],
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 1
                },
                "reference_type": {
                  "enum": [
                    "action",
                    "state",
                    "resource",
                    "procedure"
                  ]
                },
                "reference_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "round_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "condition": {
                  "type": "string",
                  "maxLength": 1000
                }
              }
            }
          },
          "when_to_use": {
            "type": "string",
            "maxLength": 2000
          },
          "fallback": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "question",
          "blocking"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "blocking": {
            "type": "boolean"
          },
          "candidate_choice_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        }
      }
    },
    "planner_notes": {
      "type": "string",
      "maxLength": 8000
    },
    "provider_metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
