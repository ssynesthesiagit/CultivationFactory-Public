{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Stage2_Advancement_Proposal_v2.schema.json",
  "title": "Stage 2 Rules-Causal Advancement Proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "expected_project_revision",
    "expected_content_lock_hash",
    "target_cl",
    "idempotency_key",
    "choices"
  ],
  "properties": {
    "schema_version": {
      "const": "TianxiaFoundry.Stage2AdvancementProposal.v2"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "expected_project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expected_content_lock_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_cl": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "effective_cl",
          "record_id",
          "acquisition_channel",
          "parameters"
        ],
        "properties": {
          "kind": {
            "enum": [
              "starting_state",
              "background_acquisition",
              "background_sphere_acquisition",
              "background_talent_acquisition",
              "origin_insight_acquisition",
              "cultivation_insight_acquisition",
              "path_acquisition",
              "sect_trial_sphere_acquisition",
              "sect_trial_talent_acquisition",
              "ai_bootstrap_sphere_acquisition",
              "ai_bootstrap_talent_acquisition",
              "level_advance",
              "ability_score_change",
              "level_talent_acquisition",
              "subpath_acquisition",
              "method_acquisition",
              "method_activation",
              "foundation_acquisition",
              "foundation_expression",
              "foundation_stage",
              "training_source_access",
              "sphere_training_attempt",
              "talent_training_attempt",
              "manual_training_attempt",
              "new_sphere_bonus_talent_acquisition",
              "equipment_acquisition",
              "printed_rule_grant",
              "forged_technique_creation",
              "typed_none"
            ]
          },
          "effective_cl": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "acquisition_channel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ability_scores": {
                "type": "object",
                "additionalProperties": false,
                "required": ["STR", "DEX", "CON", "INT", "WIS", "CHA"],
                "properties": {
                  "STR": {"type": "integer"},
                  "DEX": {"type": "integer"},
                  "CON": {"type": "integer"},
                  "INT": {"type": "integer"},
                  "WIS": {"type": "integer"},
                  "CHA": {"type": "integer"}
                }
              },
              "ability": {"enum": ["STR", "DEX", "CON", "INT", "WIS", "CHA"]},
              "amount": {"type": "integer"},
              "deltas": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "STR": {"type": "integer"},
                  "DEX": {"type": "integer"},
                  "CON": {"type": "integer"},
                  "INT": {"type": "integer"},
                  "WIS": {"type": "integer"},
                  "CHA": {"type": "integer"}
                }
              },
              "stage": {"type": "string", "minLength": 1, "maxLength": 240},
              "access_mode": {"type": "string", "minLength": 1, "maxLength": 240},
              "attempt_id": {"type": "string", "minLength": 1, "maxLength": 240},
              "retry_of_attempt_id": {"type": ["string", "null"]},
              "training_source_record_id": {"type": "string", "minLength": 1, "maxLength": 240},
              "selected_ability": {"enum": ["STR", "DEX", "CON", "INT", "WIS", "CHA"]},
              "time_die_result": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
              "dc_die_result": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
              "check_die_result": {"type": "integer"},
              "entitlement_event_id": {"type": "string", "minLength": 1, "maxLength": 240},
              "entitlement_attempt_id": {"type": "string", "minLength": 1, "maxLength": 240},
              "target": {"enum": ["method", "foundation", "manuals", "equipment", "subpaths", "forged_techniques"]},
              "reason_code": {"type": "string", "minLength": 1, "maxLength": 240},
              "reason": {"type": "string", "minLength": 1},
              "refill_current": {"type": "boolean"},
              "prewritten_record_id": {"type": "string", "minLength": 1, "maxLength": 240}
            }
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
