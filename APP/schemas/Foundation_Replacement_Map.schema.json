{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Foundation_Replacement_Map.schema.json",
  "title": "Tianxia Foundation Replacement Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replacement_pack_id",
    "replacement_pack_version",
    "replacements"
  ],
  "properties": {
    "schema_version": {
      "const": "TianxiaFoundry.FoundationReplacementMap.v1"
    },
    "replacement_pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "replacement_pack_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "replacement_id",
          "source",
          "target_record_id",
          "mode",
          "reason"
        ],
        "properties": {
          "replacement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "record_hash",
              "pack_id",
              "pack_version",
              "pack_hash"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "record_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pack_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "pack_version": {
                "type": "string",
                "minLength": 1
              },
              "pack_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "target_record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "mode": {
            "const": "replace_in_selection"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
