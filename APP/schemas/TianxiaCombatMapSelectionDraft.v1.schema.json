{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TianxiaCombatMapSelectionDraft.v1",
  "title": "Tianxia Combat Map Selection Draft",
  "description": "Non-authoritative browser interaction state pinned to one exact combat decision. This contract cannot mutate combat state or manufacture legality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "match_id",
    "decision_id",
    "state_version",
    "actor_id",
    "controller_mode",
    "interaction_mode",
    "legal_candidate_ids",
    "preferred_candidate_id",
    "selected_candidate_id"
  ],
  "properties": {
    "schema": {"const": "TianxiaCombatMapSelectionDraft.v1"},
    "match_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "state_version": {"type": "integer", "minimum": 0},
    "actor_id": {"type": "string", "minLength": 1},
    "controller_mode": {
      "enum": ["MANUAL", "SUGGESTED", "MANUAL_AI_BRIDGE"]
    },
    "interaction_mode": {
      "enum": ["select_target", "select_destination", "select_area"]
    },
    "legal_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^candidate:"}
    },
    "preferred_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^candidate:"
    },
    "selected_candidate_id": {
      "type": ["string", "null"],
      "pattern": "^candidate:"
    }
  }
}
