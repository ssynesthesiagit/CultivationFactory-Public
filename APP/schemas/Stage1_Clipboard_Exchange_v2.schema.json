{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Stage1_Clipboard_Exchange_v2.schema.json",
  "title": "Tianxia Foundry Stage 1 Blueprint Intent Exchange",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "prompt_id", "project_id", "project_revision", "prompt_sha256", "exact_response_sha256", "parsing_status", "validation", "decisions"],
  "properties": {
    "schema_version": {"const": "TianxiaFoundry.Stage1ClipboardExchange.v2"}, "attempt_id": {"type": "string"}, "prompt_id": {"type": "string"}, "project_id": {"type": "string"},
    "project_revision": {"type": "integer", "minimum": 0}, "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "exact_response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parsing_status": {"enum": ["parsed", "malformed_json"]}, "validation": {"type": "object"}, "response_id": {"type": "string"},
    "computed_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "submitted_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_batch": {"type": ["object", "null"]}, "decisions": {"type": "array", "items": {"type": "object"}}, "approval": {"type": "object"}, "commit": {"type": "object"}
  }
}
