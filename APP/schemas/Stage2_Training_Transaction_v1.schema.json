{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianxia.local/foundry/schemas/Stage2_Training_Transaction_v1.schema.json",
  "title": "Stage 2 Training Transaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "retry_of_attempt_id",
    "character_cl",
    "training_type",
    "target_record_id",
    "target_record_hash",
    "training_source_record_id",
    "training_source_record_hash",
    "selected_ability",
    "time_die_result",
    "pb_input",
    "ability_modifier_input",
    "training_days_formula_id",
    "computed_training_days",
    "dc_die_result",
    "dc_formula_id",
    "dc_inputs",
    "computed_dc",
    "check_total",
    "result",
    "slot_cost",
    "acquisition_event_id"
  ],
  "properties": {
    "schema_version": {"const": "TianxiaFoundry.Stage2TrainingTransaction.v1"},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "retry_of_attempt_id": {"type": ["string", "null"]},
    "character_cl": {"type": "integer", "minimum": 1, "maximum": 20},
    "training_type": {"enum": ["new_sphere", "known_sphere_talent", "recorded_art", "published_other"]},
    "target_record_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "target_record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "training_source_record_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "training_source_record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_ability": {"enum": ["INT", "WIS"]},
    "time_die_result": {"type": "integer", "minimum": 1, "maximum": 6},
    "pb_input": {"type": "integer", "minimum": 2, "maximum": 6},
    "ability_modifier_input": {"type": "integer", "minimum": -5, "maximum": 10},
    "training_days_formula_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "computed_training_days": {"type": "integer", "minimum": 2},
    "dc_die_result": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
    "dc_formula_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "dc_inputs": {"type": "object"},
    "computed_dc": {"type": "integer", "minimum": 0},
    "check_total": {"type": "integer", "minimum": -20, "maximum": 100},
    "result": {"enum": ["success", "failure"]},
    "slot_cost": {"type": "integer", "minimum": 0, "maximum": 3},
    "acquisition_event_id": {"type": ["string", "null"]}
  }
}
